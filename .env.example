# ══════════════════════════════════════════════════════════════
# BlogBoard configuration — copy to `.env` and fill in.
# Every value is OPTIONAL except the LLM key (for real generation).
# With no config at all, the pipeline runs in local-storage mode.
# ══════════════════════════════════════════════════════════════

# ── LLM (required for real generation) ──
# Get a free key at https://console.groq.com
LLM__API_KEY=""

# ── Storage backend: "r2" (Cloudflare) or "local" (filesystem) ──
STORAGE_BACKEND="local"
# Where the local backend writes (relative to project root)
LOCAL_STORAGE_ROOT="blogboard/web"

# ── Cloudflare R2 (only if STORAGE_BACKEND=r2) ──
R2__ACCOUNT_ID=""
R2__ACCESS_KEY_ID=""
R2__SECRET_ACCESS_KEY=""
R2__BUCKET_NAME=""

# ── Content APIs (optional — used by the News agent & cover images) ──
CONTENT__TAVILY_API_KEY=""
CONTENT__GUARDIAN_API_KEY=""
CONTENT__UNSPLASH_API_KEY=""

# ── Site (used for RSS + sitemap absolute URLs) ──
SITE_URL="http://localhost:8000"

# ── Admin API (optional; protects POST /api/generate when set) ──
ADMIN_TOKEN=""

# ── Observability (optional) ──
OPIK_API_KEY=""
OPIK_PROJECT_NAME="blogboard"
SENTRY_DSN=""
